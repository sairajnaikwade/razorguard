# =============================================================================
# RazorGuard Environment Configuration
# =============================================================================
# Copy this file to .env and update values for your environment.
# NEVER commit .env to version control.
# =============================================================================

# --- Database (PostgreSQL) ---
DATABASE_URL=postgresql+asyncpg://razorguard:razorguard@localhost:5432/razorguard
DATABASE_URL_SYNC=postgresql://razorguard:razorguard@localhost:5432/razorguard
POSTGRES_USER=razorguard
POSTGRES_PASSWORD=razorguard
POSTGRES_DB=razorguard

# --- Redis ---
REDIS_URL=redis://localhost:6379/0

# --- JWT ---
# IMPORTANT: Change this to a strong random secret in production
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=change-this-to-a-strong-random-secret-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- Default Admin Credentials ---
# IMPORTANT: Change these in production. Password is hashed with Argon2 on first boot.
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@razorguard.local
ADMIN_PASSWORD=change-this-admin-password

# --- AI Provider (Phase 5) ---
# AI_PROVIDER=openai
# AI_API_KEY=
# AI_MODEL=gpt-4

# --- Application ---
APP_ENV=development
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost

# --- Frontend ---
# Use /api for Docker/production (nginx proxies to backend).
# Vite dev server proxies /api to http://localhost:8000 automatically.
VITE_API_BASE_URL=/api
